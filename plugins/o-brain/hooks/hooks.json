{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/memory-inject-hook.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\memory-inject-hook.mjs\"",
            "timeout": 120,
            "additionalContextLimit": 4000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/memory-extract-hook.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\memory-extract-hook.mjs\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
